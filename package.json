{
  "name": "hermi",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["apps/web", "packages/*"],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/dev.mjs --preview",
    "dev": "node scripts/dev.mjs",
    "db:init": "node scripts/db-init.mjs",
    "doctor": "node scripts/doctor.mjs",
    "lint": "node scripts/lint.mjs",
    "format": "node scripts/format.mjs",
    "test": "node scripts/test.mjs",
    "test:api": "node scripts/test-api.mjs",
    "test:web": "npm run test --workspace apps/web",
    "gen:api": "node scripts/stub.mjs gen:api",
    "gen:shared": "node scripts/gen-shared.mjs",
    "test:kit": "npm run test:kit --workspace apps/web",
    "test:e2e": "node scripts/stub.mjs test:e2e WF-130",
    "test:e2e:smoke": "node --test scripts/e2e-smoke.mjs && npm run test:smoke -w apps/web",
    "evals": "node scripts/stub.mjs evals WF-057",
    "smoke:live": "node scripts/stub.mjs smoke:live"
  },
  "devDependencies": { "js-yaml": "^4.3.2" }
}
