# Local-ready: runs with no keys. Copy to .env (npm run setup does it). Never commit real values.
# Empty means optional; a missing key makes its provider raise NotConfigured.
# Values marked "generated" are filled in by npm run setup.

# Core
ENVIRONMENT=local
RELEASE_SHA=dev
LOG_LEVEL=DEBUG
PORT=8100
PUBLIC_API_URL=http://127.0.0.1:8100
PUBLIC_WEB_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_PROXY_CIDRS=
API_DOCS_ENABLED=true
SCHEDULER_ENABLED=false
WORKER_LANES=api,ai,notify,batch
WORKER_CONCURRENCY_API=4
WORKER_CONCURRENCY_AI=2
WORKER_CONCURRENCY_NOTIFY=4
WORKER_CONCURRENCY_BATCH=1

# Database (local roles from infra/db/bootstrap.sql; passwords are generated)
DATABASE_URL=postgresql+psycopg://hermi_api_login:change-me@localhost/hermi
DATABASE_URL_SYSTEM=postgresql+psycopg://hermi_worker_login:change-me@localhost/hermi
DATABASE_URL_ADMIN=postgresql+psycopg://hermi_admin_login:change-me@localhost/hermi
MIGRATION_DATABASE_URL=postgresql+psycopg://hermi_migrate_login:change-me@localhost/hermi
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2
DATABASE_STATEMENT_TIMEOUT_MS=15000
TEST_DATABASE_URL=postgresql+psycopg://hermi_api_login:change-me@localhost/hermi_test
TEST_DATABASE_URL_SYSTEM=postgresql+psycopg://hermi_worker_login:change-me@localhost/hermi_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://hermi_migrate_login:change-me@localhost/hermi_test
REDIS_URL=

# Identity and device trust
AUTH_MODE=dev
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_HOOK_SECRET=
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY=
APPLE_APP_ATTEST_ENV=
FIELD_ENCRYPTION_KEY=

# AI
AI_PROVIDER=claude_cli
ANTHROPIC_API_KEY=
ANTHROPIC_ADMIN_API_KEY=
AI_CLI_ALLOWED_EMAILS=
AI_CLI_MAX_CONCURRENCY=1
AI_CLI_SCRATCH_DIR=.data/ai-scratch
CLAUDE_CLI_PATH=
AI_MODEL_FAST=claude-haiku-4-5
AI_MODEL_MAIN=claude-sonnet-5-5
AI_GLOBAL_DAILY_CAP_USD=150
AI_ALERT_DAILY_MULTIPLIER=1.5
PROMPT_VERSION=dev
EVALS_LIVE=0

# Payments
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_API_KEY=
VITE_REVENUECAT_KEY_IOS=

# Modes and backends
PROVIDERS_MODE=fake
STORAGE_BACKEND=local
EMAIL_BACKEND=file
IMPORT_SANDBOX=timeout_only

# Data, affiliate and travel providers
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
VIATOR_API_KEY=
STAY22_AID=hermi
SERPAPI_API_KEY=
SERPAPI_MONTHLY_CAP=5000
GEOAPIFY_API_KEY=
WIKIMEDIA_CONTACT=dev@localhost
FRANKFURTER_BASE_URL=https://api.frankfurter.dev

# Messaging, storage, observability
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=Hermi <dev@localhost>
UNSUBSCRIBE_SECRET=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=
APNS_USE_SANDBOX=true
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_BUCKET_UPLOADS=
R2_BUCKET_EXPORTS=
R2_BUCKET_BACKUPS=
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
POSTHOG_KEY=
VITE_POSTHOG_KEY=
POSTHOG_HOST=
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_HEARTBEAT_SCHEDULER=
BETTERSTACK_HEARTBEAT_QUEUE=
ALERT_WEBHOOK_URL=

# Admin and web client
ADMIN_AUTH_MODE=dev
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
ADMIN_SESSION_SECRET=
VITE_API_BASE_URL=http://127.0.0.1:8100
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_ENV=local
STATUS_PAGE_URL=
VITE_STATUS_PAGE_URL=

# Local tooling only: PostgreSQL 18 bin directory when it is not in the default path
# PG_BIN=
